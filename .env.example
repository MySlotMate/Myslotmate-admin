# Base URL of the MySlotMate backend API.
# Local dev: http://localhost:5000  (backend HTTP_PORT)
# Production: https://api.myslotmate.com
VITE_API_BASE_URL=http://localhost:5000

# Boost with a paid ad budget and Premium Hosts (PRD: Premium Hosts and paid
# Boost marketing). Unset: on in local development, off in production builds.
# VITE_ENABLE_BOOST_PLAN=false
# Run those screens on the stand-in kept in the browser until the backend
# serves them. Unset: on in local development only.
# VITE_BOOST_PLAN_MOCK=false
